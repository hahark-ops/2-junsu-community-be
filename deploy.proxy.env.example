BE_IMAGE=docker.io/hahark283/community-be:latest
FE_IMAGE=docker.io/hahark283/community-fe:latest
DB_IMAGE=docker.io/hahark283/community-db:latest

MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=community_db
DB_USER=community_user
DB_PASSWORD=change_me_password

# 도메인 적용 전에는 http://<EC2_PUBLIC_IP>만 넣어도 동작합니다.
CORS_ALLOW_ORIGINS=http://YOUR_EC2_PUBLIC_IP,http://YOUR_DOMAIN,https://YOUR_DOMAIN

# HTTPS 적용 전: false/lax 권장
# HTTPS 적용 후: true/lax 또는 true/none(크로스 사이트 필요 시)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=604800

MAX_UPLOAD_SIZE_BYTES=26214400
MAX_PROFILE_UPLOAD_SIZE_BYTES=26214400
MAX_POST_UPLOAD_SIZE_BYTES=31457280

# local | s3 | lambda
UPLOAD_PROVIDER=local
UPLOAD_LAMBDA_API_URL=
S3_BUCKET_NAME=
S3_OBJECT_PREFIX=uploads
S3_BASE_URL=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BCRYPT_ROUNDS=12

# HTTPS + 도메인용
DOMAIN=example.com
EMAIL=you@example.com
