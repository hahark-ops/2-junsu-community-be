# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=community_user
DB_PASSWORD=change_me
DB_NAME=community_db
DB_POOL_NAME=community_pool
DB_POOL_SIZE=5

# API
#CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# S3 정적 호스팅 프론트 사용 시 예시:
CORS_ALLOW_ORIGINS=http://community-fe.s3-website.ap-northeast-2.amazonaws.com

# Session cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=604800
# COOKIE_DOMAIN=example.com
# 크로스 도메인(예: FE=S3, BE=EC2) 쿠키 사용 시:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Upload
MAX_UPLOAD_SIZE_BYTES=5242880
UPLOAD_PROVIDER=s3

# S3 (UPLOAD_PROVIDER=s3)
# 권장: EC2 IAM Role 사용 (AWS_ACCESS_KEY_ID/SECRET 미사용)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=community-be
S3_OBJECT_PREFIX=uploads
# 선택: CloudFront 또는 커스텀 도메인
# S3_BASE_URL=https://cdn.example.com

# Security
BCRYPT_ROUNDS=12
