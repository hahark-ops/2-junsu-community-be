# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=community_user
DB_PASSWORD=change_me
DB_NAME=community_db
DB_POOL_NAME=community_pool
DB_POOL_SIZE=5

# API
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=604800
