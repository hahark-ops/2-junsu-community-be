# Local private registry image tags
BE_IMAGE=localhost:5000/community-be:local
FE_IMAGE=localhost:5000/community-fe:local
DB_IMAGE=localhost:5000/community-db:local

# DB bootstrap
MYSQL_ROOT_PASSWORD=root_password
DB_NAME=community_db
DB_USER=community_user
DB_PASSWORD=community_password

# App env
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=604800

MAX_UPLOAD_SIZE_BYTES=26214400
MAX_PROFILE_UPLOAD_SIZE_BYTES=26214400
MAX_POST_UPLOAD_SIZE_BYTES=31457280

# Upload provider
UPLOAD_PROVIDER=local
UPLOAD_LAMBDA_API_URL=
S3_BUCKET_NAME=
S3_OBJECT_PREFIX=uploads
S3_BASE_URL=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BCRYPT_ROUNDS=12
